# Copy this file to .env (git-ignored) for Docker Compose / deployment.
# Placeholder values only — never commit real credentials.
# For IDE-local runs, use backend/config/application-local.properties instead.
POSTGRES_DB=cleargrade
POSTGRES_USER=cleargrade_app
POSTGRES_PASSWORD=CHANGE_ME_LOCALLY
POSTGRES_PORT=5432
APP_PORT=8080
FRONTEND_PORT=3000
# Optional: override the 10 MiB upload cap (bytes). The nginx proxy keeps a
# small multipart allowance above this value.
CLEARGRADE_UPLOAD_MAX_FILE_SIZE=10485760

# Optional: ClearGrade Intelligence. All four values are optional; leave them
# blank to use the deterministic rule-based engine. Never commit a real key.
# Reuse an existing local GEMINI_API_KEY by copying its value into this ignored
# .env file (not into chat, logs, frontend variables or Docker build arguments).
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT_READ_MS=60000
# Local Windows Ollama installed via winget; backend reaches it via host.docker.internal
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:1b
# OLLAMA_TIMEOUT_READ_MS=60000
CLEARGRADE_AI_ENABLED=true
CLEARGRADE_AI_DETERMINISTIC_ENABLED=true
CLEARGRADE_AI_COOLDOWN_SECONDS=0

# Native development (mvn spring-boot:run / npm run dev). Spring Boot imports
# this file automatically; never put real secret values in this committed example.
# NATIVE_PG_SUPERUSER_PASSWORD=
# CLEARGRADE_LOCAL_DB_URL=jdbc:postgresql://localhost:5432/cleargrade
# CLEARGRADE_LOCAL_DB_USER=cleargrade_local
# CLEARGRADE_LOCAL_DB_PASSWORD=
# CLEARGRADE_LOCAL_SERVER_ADDRESS=127.0.0.1
# CLEARGRADE_LOCAL_OLLAMA_BASE_URL=http://127.0.0.1:11434
