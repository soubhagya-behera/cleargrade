# Copy this file to .env (git-ignored) for Docker Compose / deployment.
# Placeholder values only — never commit real credentials.
# For IDE-local runs, use backend/config/application-local.properties instead.
POSTGRES_DB=cleargrade
POSTGRES_USER=cleargrade_app
POSTGRES_PASSWORD=CHANGE_ME_LOCALLY
POSTGRES_PORT=5432
APP_PORT=8080
FRONTEND_PORT=3000
# Optional: override the 10 MiB upload cap (bytes). The nginx proxy keeps a
# small multipart allowance above this value.
CLEARGRADE_UPLOAD_MAX_FILE_SIZE=10485760
