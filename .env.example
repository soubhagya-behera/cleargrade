# ClearGrade — environment template
#
# Copy this file to .env (git-ignored). Values here are placeholders only.
# NEVER commit a real password or API key. application.properties owns all
# non-secret defaults, so most variables below are optional.

# ---------------------------------------------------------------------------
# 1. NATIVE POSTGRESQL CREDENTIALS  (needed for: mvn spring-boot:run)
# ---------------------------------------------------------------------------
# The backend defaults to jdbc:postgresql://localhost:5432/cleargrade with
# username cleargrade_local. Only the application role password is private.
#
# CLEARGRADE_LOCAL_DB_PASSWORD
#   Required for native development. Password of the least-privilege
#   cleargrade_local role that owns/migrates the application tables.
#   The application CANNOT start correctly without it.
#   pgAdmin: use the same value at the password prompt for the
#   "ClearGrade Local (cleargrade)" server entry.
CLEARGRADE_LOCAL_DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD

# ---------------------------------------------------------------------------
# 2. OPTIONAL GEMINI API KEY  (needed for: native + Docker, optional)
# ---------------------------------------------------------------------------
# GEMINI_API_KEY
#   Optional. Enables Gemini as the primary AI provider. Leave blank/commented
#   and ClearGrade still starts, imports work, and Ollama or the rule engine
#   analyses imports. Never paste this into chat, Vite, logs or Docker builds.
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# 3. DOCKER-ONLY CONFIGURATION  (needed for: docker compose up)
# ---------------------------------------------------------------------------
# The Compose stack has its own PostgreSQL on a separate host port and its own
# named volume. These values are NOT used by the native workflow.

# POSTGRES_PASSWORD
#   Required by Docker Compose only; password for the Docker PostgreSQL
#   superuser. The native database does not use it.
POSTGRES_PASSWORD=CHANGE_ME_DOCKER_DB_PASSWORD

# POSTGRES_PORT
#   Optional Docker-only host port override (default 5432). Set a different
#   value if the native PostgreSQL service already owns 5432.
# POSTGRES_PORT=55432

# APP_PORT / FRONTEND_PORT
#   Optional Docker-only host port overrides (defaults 8080 / 3000).
# APP_PORT=8080
# FRONTEND_PORT=3000

# OLLAMA_BASE_URL / OLLAMA_MODEL
#   Optional Docker-only overrides so the backend container can reach a
#   Windows/macOS host Ollama. Native runs use 127.0.0.1:11434 by default.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2:1b

# CLEARGRADE_UPLOAD_MAX_FILE_SIZE
#   Optional Docker-only upload cap override (default 10485760 bytes).
# CLEARGRADE_UPLOAD_MAX_FILE_SIZE=10485760
